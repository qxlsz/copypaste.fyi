# Copy into .env next to docker-compose.yml.
# Public copypaste.fyi stays anonymous. These knobs are for YOUR box.

# --- internal LAN / lock it ---
COPYPASTE_REQUIRE_WRITE_AUTH=false
COPYPASTE_AUTH_TOKEN=
COPYPASTE_ADMIN_TOKEN=
COPYPASTE_REQUIRE_CHALLENGE=false
COPYPASTE_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- rate limit and auto-ban ---
# 0 disables that limiter. Ban is off until COPYPASTE_BAN_AFTER is set.
COPYPASTE_RATE_LIMIT_CREATES=10
COPYPASTE_RATE_LIMIT_READS=120
COPYPASTE_BAN_AFTER=
COPYPASTE_BAN_SECONDS=600
COPYPASTE_MAX_PASTE_SIZE=1048576

# --- store ---
COPYPASTE_PERSISTENCE_BACKEND=memory
COPYPASTE_FORCE_MEMORY=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

COPYPASTE_BLOCKED_PASTE_IDS=
ROCKET_LOG_LEVEL=normal
